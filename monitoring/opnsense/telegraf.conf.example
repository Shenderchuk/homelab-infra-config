[global_tags]

[agent]
  interval = "10s"
  round_interval = true
  metric_batch_size = 1000
  metric_buffer_limit = 10000
  collection_jitter = "0s"
  flush_interval = "10s"
  flush_jitter = "0s"
  precision = ""
  debug = true
  quiet = true
  hostname = "gw01-i7505"
  omit_hostname = false

[[outputs.influxdb_v2]]
  urls = ["http://192.168.50.44:8086"]
  token = "REPLACE_WITH_INFLUX_TOKEN"
  organization = "REPLACE_WITH_INFLUX_ORG"
  bucket = "opnsense"
  insecure_skip_verify = true
  timeout = "5s"

[[inputs.cpu]]
  percpu = true
  totalcpu = true
  collect_cpu_time = false

[[inputs.disk]]

[[inputs.diskio]]

[[inputs.internet_speed]]
  memory_saving_mode = true
  interval = "360s"

[[inputs.mem]]

[[inputs.processes]]

[[inputs.swap]]

[[inputs.system]]

[[inputs.net]]

[[inputs.ping]]
  method = "exec"
  binary = "ping"
  urls = ["192.168.50.4"]

[[inputs.unbound]]
  binary = "/usr/local/sbin/unbound-control"
  config_file = "/var/unbound/unbound.conf"
  thread_as_tag = true
  timeout = "5s"
