                      "spec": {
                        "query": "from(bucket: \"opnsense\")\r\n  |\u003e range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |\u003e filter(fn: (r) =\u003e\r\n    r._measurement == \"opnsense_temperature\" and\r\n    r._field == \"value\" and\r\n    r.host == \"gw01-i7505\"\r\n  )\r\n  |\u003e map(fn: (r) =\u003e ({ r with device: if exists r.device then r.device else \"opnsense\" }))\r\n  |\u003e aggregateWindow(\r\n    every: v.windowPeriod,\r\n    fn: mean,\r\n    createEmpty: false\r\n  )\r\n  |\u003e keep(columns: [\"_time\", \"_value\", \"type\", \"device\", \"sensor\"])\r\n  |\u003e group(columns: [\"type\", \"device\", \"sensor\"])\r\n  |\u003e yield(name: \"temperature\")"
