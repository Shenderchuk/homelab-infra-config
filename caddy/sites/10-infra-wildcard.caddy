*.infra.shshx.net {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	@portainer host portainer.infra.shshx.net
	handle @portainer {
		reverse_proxy https://192.168.50.42:9443 {
			transport http {
				tls_insecure_skip_verify
			}
            header_up Host {host}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
		}
	}

	@homer host homer.infra.shshx.net
	handle @homer {
		reverse_proxy 192.168.50.42:80
	}

	@gitea host gitea.infra.shshx.net
	handle @gitea {
		reverse_proxy 192.168.50.42:3000
	}

	@uptime_kuma host uptime-kuma.infra.shshx.net
	handle @uptime_kuma {
		reverse_proxy 192.168.50.42:3001
	}

	@registry host registry.infra.shshx.net
	handle @registry {
		reverse_proxy 192.168.50.42:5000
	}

	@qbittorrent host qbittorrent.infra.shshx.net
	handle @qbittorrent {
		reverse_proxy 192.168.50.42:8085
	}

	@jellyfin host jellyfin.infra.shshx.net
	handle @jellyfin {
		reverse_proxy 192.168.50.42:8096
	}

	@n8n host n8n.infra.shshx.net
	handle @n8n {
		reverse_proxy 192.168.50.42:5678
	}

	@navidrome host navidrome.infra.shshx.net
	handle @navidrome {
		redir / /app/
		reverse_proxy 192.168.50.42:4533
	}

	@immich host immich.infra.shshx.net
	handle @immich {
		reverse_proxy 192.168.50.46:2283
	}

	@influxdb host influxdb.infra.shshx.net
	handle @influxdb {
		reverse_proxy 192.168.50.44:8086
	}

	@grafana host grafana.infra.shshx.net
	handle @grafana {
		reverse_proxy 192.168.50.43:3000
	}

	@loki host loki.infra.shshx.net
	handle @loki {
		reverse_proxy 192.168.50.47:3100
	}

	@pve01_n150 host pve01-n150.infra.shshx.net
	handle @pve01_n150 {
		reverse_proxy https://192.168.50.10:8006 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	@pve02_m80q host pve02-m80q.infra.shshx.net
	handle @pve02_m80q {
		reverse_proxy https://192.168.50.11:8006 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	@ap01_gtaxe16000 host ap01-gtaxe16000.infra.shshx.net
	handle @ap01_gtaxe16000 {
		reverse_proxy 192.168.50.2:80
	}

	@sw01_crs310 host sw01-crs310.infra.shshx.net
	handle @sw01_crs310 {
		reverse_proxy 192.168.50.4:80
	}

	@nas01_qnap host nas01-qnap.infra.shshx.net nashnas.infra.shshx.net
	handle @nas01_qnap {
		reverse_proxy 192.168.50.39:8080
	}

	@ha host ha.infra.shshx.net
	handle @ha {
		reverse_proxy 192.168.50.41:8123
	}

	respond "Unknown local service" 404
}
